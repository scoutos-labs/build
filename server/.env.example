# Copy to server/.env for local development (gitignored).
# Clerk dashboard → API keys → Secret key
CLERK_SECRET_KEY=sk_test_...
# Clerk dashboard → Webhooks → endpoint signing secret (svix).
# OPTIONAL in dev: omit and provisioning happens lazily on first agent call.
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# OpenRouter → Settings → Provisioning keys (root credential, rotate quarterly)
OPENROUTER_PROVISIONING_KEY=sk-or-...
# Embedded PGlite storage dir (optional; defaults to server/.data)
# PGLITE_DATA_DIR=.data
# Any high-entropy string; derives the AES-256-GCM key for keys at rest
KEY_ENCRYPTION_SECRET=change-me-to-something-long-and-random
# Optional: Brave Search API key for the agent's web_search tool.
# Without it web_search reports itself unavailable (web_fetch/web_post still work).
# BRAVE_SEARCH_API_KEY=BSA...
